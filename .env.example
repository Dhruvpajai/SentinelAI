# Application
APP_NAME=SentinelAI
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Database (SQLite for development)
DATABASE_URL=sqlite:///./sentinelai.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
